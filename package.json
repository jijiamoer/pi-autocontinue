{
  "name": "pi-autocontinue",
  "version": "0.1.2-lody.2",
  "description": "A bounded keepalive extension that continues the current Pi task after the agent settles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/limars874/pi-autocontinue.git"
  },
  "homepage": "https://github.com/limars874/pi-autocontinue#readme",
  "bugs": {
    "url": "https://github.com/limars874/pi-autocontinue/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": ["pi-package", "pi", "pi-extension", "autocontinue", "keepalive", "agent"],
  "files": ["src", "README.md", "LICENSE"],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0 <1.0.0 || >=1.3.0 <1.4.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <1.0.0 || >=1.3.0 <1.4.0",
    "@earendil-works/pi-tui": ">=0.83.0 <1.0.0 || >=1.3.0 <1.4.0",
    "typebox": ">=1.1.24 <2.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^20.0.0",
    "typebox": "1.1.24",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
